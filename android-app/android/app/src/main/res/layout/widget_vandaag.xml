<?xml version="1.0" encoding="utf-8"?>
<!-- widget "Vandaag": machine die aftelt, afspraken en herinneringen van vandaag, ophaling morgen -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="14dp">
    <TextView
        android:id="@+id/w_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:text="Vandaag"
        android:textColor="@color/w_ink"
        android:textSize="15sp"
        android:textStyle="bold" />
    <LinearLayout
        android:id="@+id/w_machine"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">
        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_wash_ink" />
        <Chronometer
            android:id="@+id/w_chrono"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textColor="@color/w_ink"
            android:textSize="16sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/w_mlabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:textColor="@color/w_muted"
            android:textSize="13sp" />
    </LinearLayout>
    <TextView
        android:id="@+id/w_r1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:singleLine="true"
        android:ellipsize="end"
        android:textColor="@color/w_ink"
        android:textSize="13.5sp"
        android:visibility="gone" />
    <TextView
        android:id="@+id/w_r2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:singleLine="true"
        android:ellipsize="end"
        android:textColor="@color/w_ink"
        android:textSize="13.5sp"
        android:visibility="gone" />
    <TextView
        android:id="@+id/w_r3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:singleLine="true"
        android:ellipsize="end"
        android:textColor="@color/w_ink"
        android:textSize="13.5sp"
        android:visibility="gone" />
    <TextView
        android:id="@+id/w_r4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:singleLine="true"
        android:ellipsize="end"
        android:textColor="@color/w_ink"
        android:textSize="13.5sp"
        android:visibility="gone" />
    <TextView
        android:id="@+id/w_r5"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:singleLine="true"
        android:ellipsize="end"
        android:textColor="@color/w_ink"
        android:textSize="13.5sp"
        android:visibility="gone" />
    <TextView
        android:id="@+id/w_r6"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:singleLine="true"
        android:ellipsize="end"
        android:textColor="@color/w_ink"
        android:textSize="13.5sp"
        android:visibility="gone" />
    <TextView
        android:id="@+id/w_more"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/w_muted"
        android:textSize="12sp"
        android:visibility="gone" />
    <TextView
        android:id="@+id/w_waste"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:singleLine="true"
        android:ellipsize="end"
        android:textColor="@color/w_muted"
        android:textSize="12.5sp"
        android:visibility="gone" />
</LinearLayout>
