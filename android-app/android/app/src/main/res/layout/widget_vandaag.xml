<?xml version="1.0" encoding="utf-8"?>
<!-- widget "Vandaag" (4×1, doorzichtig): per item een rond icoontje; hoe breder, hoe meer uitleg; niets gepland = niets zichtbaar -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_vertical|start"
    android:orientation="horizontal"
    android:paddingStart="4dp"
    android:paddingEnd="4dp">
    <LinearLayout
        android:id="@+id/w_s1"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_marginEnd="6dp"
        android:background="@drawable/widget_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="12dp"
        android:visibility="visible">
        <ImageView
            android:id="@+id/w_i1"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/wp_wash" />
        <Chronometer
            android:id="@+id/w_c1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:shadowColor="#80000000"
            android:shadowRadius="3"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />
        <TextView
            android:id="@+id/w_t1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:maxWidth="170dp"
            android:shadowColor="#80000000"
            android:shadowRadius="3"
            android:singleLine="true"
            android:ellipsize="end"
            android:text="1:12"
            android:textColor="#FFFFFF"
            android:textSize="13.5sp"
            android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/w_s2"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_marginEnd="6dp"
        android:background="@drawable/widget_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="12dp"
        android:visibility="visible">
        <ImageView
            android:id="@+id/w_i2"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/wp_cal" />
        <Chronometer
            android:id="@+id/w_c2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:shadowColor="#80000000"
            android:shadowRadius="3"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />
        <TextView
            android:id="@+id/w_t2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:maxWidth="170dp"
            android:shadowColor="#80000000"
            android:shadowRadius="3"
            android:singleLine="true"
            android:ellipsize="end"
            android:text="14:00 Scouts"
            android:textColor="#FFFFFF"
            android:textSize="13.5sp"
            android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/w_s3"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_marginEnd="6dp"
        android:background="@drawable/widget_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="12dp"
        android:visibility="visible">
        <ImageView
            android:id="@+id/w_i3"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/wp_trash" />
        <Chronometer
            android:id="@+id/w_c3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:shadowColor="#80000000"
            android:shadowRadius="3"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />
        <TextView
            android:id="@+id/w_t3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:maxWidth="170dp"
            android:shadowColor="#80000000"
            android:shadowRadius="3"
            android:singleLine="true"
            android:ellipsize="end"
            android:text="PMD"
            android:textColor="#FFFFFF"
            android:textSize="13.5sp"
            android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/w_s4"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_marginEnd="6dp"
        android:background="@drawable/widget_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="12dp"
        android:visibility="gone">
        <ImageView
            android:id="@+id/w_i4"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/wp_cal" />
        <Chronometer
            android:id="@+id/w_c4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:shadowColor="#80000000"
            android:shadowRadius="3"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />
        <TextView
            android:id="@+id/w_t4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:maxWidth="170dp"
            android:shadowColor="#80000000"
            android:shadowRadius="3"
            android:singleLine="true"
            android:ellipsize="end"
            android:text=""
            android:textColor="#FFFFFF"
            android:textSize="13.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/w_sum"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="@drawable/widget_pill"
        android:ellipsize="end"
        android:maxLines="2"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:shadowColor="#80000000"
        android:shadowRadius="3"
        android:textColor="#FFFFFF"
        android:textSize="12.5sp"
        android:visibility="gone" />
</LinearLayout>
